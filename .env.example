# Banking MCP (official, authenticated)
ROBINHOOD_BANKING_MCP_SERVER_NAME=robinhood-banking
ROBINHOOD_BANKING_MCP_URL=https://banking-agent.robinhood.com/mcp/banking

# Trading MCP
ROBINHOOD_TRADING_MCP_SERVER_NAME=robinhood-trading
ROBINHOOD_TRADING_MCP_URL=https://agent.robinhood.com/mcp/trading

# Optional wrapper app settings. These are placeholders only.
ROBINHOOD_MCP_OAUTH_CALLBACK_URL=
ROBINHOOD_MCP_AWS_REGION=us-east-2
ROBINHOOD_MCP_AWS_SECRET_ID=robinhood/mcp/config
ROBINHOOD_MCP_CF_ACCOUNT_ID=
ROBINHOOD_MCP_CF_WORKER_NAME=

# Optional secrets for your own wrapper tooling. Leave blank unless you create them.
ROBINHOOD_MCP_CLIENT_ID=
ROBINHOOD_MCP_CLIENT_SECRET=
ROBINHOOD_MCP_SESSION_ENCRYPTION_KEY=

# Automated OAuth token refresh (RH-5 / H5). See docs/runbooks/rotate-secrets.md.
# These are non-secret vars for the Cloudflare Worker. Refresh tokens and the
# Cloudflare API token itself are Worker secrets, NOT stored here.
TOKEN_REFRESH_ENABLED=false
TOKEN_REFRESH_THRESHOLD_SECONDS=1800
ROBINHOOD_MCP_OAUTH_TOKEN_ENDPOINT=
ROBINHOOD_MCP_OAUTH_CLIENT_ID=
